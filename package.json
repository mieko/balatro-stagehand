{
  "name": "balatro-stagehand",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": "./client/balatro.mjs",
  "dependencies": {
    "@zip.js/zip.js": "2.25.0",
    "esbuild": "0.28.2",
    "godot-stagehand": "file:./stagehand",
    "tar": "7.5.23",
    "ws": "^8.23.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:runtime": "node --test test/runtime/*.test.mjs",
    "prepare:game": "node tools/prepare.mjs",
    "launch": "node tools/launch.mjs",
    "format:lua": "stylua --verify --glob \"**/*.lua\" --glob \"!mod/vendor/**\" mod test",
    "format:js": "prettier --write \"client/**/*.mjs\" \"test/**/*.mjs\" \"tools/**/*.mjs\" \"*.json\" \".github/**/*.yml\" \"mod/*.json\"",
    "format:docs": "prettier --write \"*.md\" \"docs/**/*.md\" \"mod/vendor/README.md\"",
    "format": "npm run format:lua && npm run format:js && npm run format:docs",
    "format:check": "stylua --check --verify --glob \"**/*.lua\" --glob \"!mod/vendor/**\" mod test && prettier --check \"client/**/*.mjs\" \"test/**/*.mjs\" \"tools/**/*.mjs\" \"*.json\" \"*.md\" \"docs/**/*.md\" \"mod/vendor/README.md\" \".github/**/*.yml\" \"mod/*.json\"",
    "test:setup": "node --test test/setup.test.mjs",
    "fetch:lovely": "node tools/fetch-lovely.mjs",
    "build:mod": "node tools/build-mod.mjs",
    "update:manifest": "node tools/build-mod.mjs --manifest"
  },
  "devDependencies": {
    "@johnnymorganz/stylua-bin": "2.6.0",
    "prettier": "3.10.1"
  },
  "engines": {
    "node": ">=22"
  }
}
